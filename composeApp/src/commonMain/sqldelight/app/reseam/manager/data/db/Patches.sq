CREATE TABLE patches (
    id TEXT NOT NULL PRIMARY KEY,
    bundle_id TEXT NOT NULL,
    name TEXT NOT NULL,
    description TEXT NOT NULL,
    enabled_by_default INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(bundle_id) REFERENCES bundles(id) ON DELETE CASCADE
);

CREATE INDEX patches_by_bundle ON patches(bundle_id);

selectByBundle:
SELECT * FROM patches WHERE bundle_id = ? ORDER BY name;

selectByPackageAndTrusted:
SELECT p.*
FROM patches p
INNER JOIN patch_compatibility pc ON pc.patch_id = p.id
INNER JOIN bundles b ON b.id = p.bundle_id
WHERE pc.package_name = ? AND b.trusted = 1
GROUP BY p.id
ORDER BY p.name;

countCompatibleByPackage:
SELECT pc.package_name, COUNT(DISTINCT p.id) AS patch_count
FROM patches p
INNER JOIN patch_compatibility pc ON pc.patch_id = p.id
INNER JOIN bundles b ON b.id = p.bundle_id
WHERE b.trusted = 1
GROUP BY pc.package_name;

upsert:
INSERT OR REPLACE INTO patches(id, bundle_id, name, description, enabled_by_default)
VALUES (?, ?, ?, ?, ?);

deleteByBundle:
DELETE FROM patches WHERE bundle_id = ?;
