CREATE TABLE bundles (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    description TEXT NOT NULL,
    source TEXT,
    official INTEGER NOT NULL DEFAULT 0,
    trusted INTEGER NOT NULL DEFAULT 0,
    patch_count INTEGER NOT NULL DEFAULT 0,
    version TEXT,
    updated_label TEXT,
    signer_public_key_hex TEXT,
    signer_fingerprint TEXT,
    path TEXT
);

selectAll:
SELECT * FROM bundles;

selectById:
SELECT * FROM bundles WHERE id = ?;

upsert:
INSERT OR REPLACE INTO bundles(
    id, name, description, source, official, trusted, patch_count,
    version, updated_label, signer_public_key_hex, signer_fingerprint, path
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteById:
DELETE FROM bundles WHERE id = ?;
