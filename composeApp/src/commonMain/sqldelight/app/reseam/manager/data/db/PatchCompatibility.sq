CREATE TABLE patch_compatibility (
    patch_id TEXT NOT NULL,
    package_name TEXT NOT NULL,
    versions_json TEXT NOT NULL DEFAULT '[]',
    PRIMARY KEY (patch_id, package_name),
    FOREIGN KEY(patch_id) REFERENCES patches(id) ON DELETE CASCADE
);

CREATE INDEX patch_compatibility_by_package ON patch_compatibility(package_name);

selectByPatch:
SELECT package_name, versions_json FROM patch_compatibility WHERE patch_id = ?;

upsert:
INSERT OR REPLACE INTO patch_compatibility(patch_id, package_name, versions_json)
VALUES (?, ?, ?);

deleteByPatch:
DELETE FROM patch_compatibility WHERE patch_id = ?;
