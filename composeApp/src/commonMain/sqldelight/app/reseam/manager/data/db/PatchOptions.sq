CREATE TABLE patch_options (
    patch_id TEXT NOT NULL,
    ord INTEGER NOT NULL,
    key TEXT NOT NULL,
    title TEXT NOT NULL,
    description TEXT NOT NULL,
    option_type TEXT NOT NULL,
    default_value_json TEXT,
    valid_values_json TEXT,
    required INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (patch_id, key),
    FOREIGN KEY(patch_id) REFERENCES patches(id) ON DELETE CASCADE
);

CREATE INDEX patch_options_by_patch ON patch_options(patch_id, ord);

selectByPatch:
SELECT key, title, description, option_type, default_value_json, valid_values_json, required
FROM patch_options
WHERE patch_id = ?
ORDER BY ord;

upsert:
INSERT OR REPLACE INTO patch_options(
    patch_id, ord, key, title, description, option_type,
    default_value_json, valid_values_json, required
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteByPatch:
DELETE FROM patch_options WHERE patch_id = ?;
