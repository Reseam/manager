CREATE TABLE settings (
    id INTEGER NOT NULL PRIMARY KEY DEFAULT 1 CHECK (id = 1),
    check_updates_daily INTEGER NOT NULL DEFAULT 1,
    analytics_enabled INTEGER NOT NULL DEFAULT 0,
    theme TEXT NOT NULL DEFAULT 'System',
    onboarding_completed INTEGER NOT NULL DEFAULT 0,
    api_base_url TEXT NOT NULL DEFAULT 'https://api.reseam.app/v1'
);

INSERT OR IGNORE INTO settings(id) VALUES (1);

select:
SELECT check_updates_daily, analytics_enabled, theme, onboarding_completed, api_base_url
FROM settings WHERE id = 1;

upsert:
INSERT OR REPLACE INTO settings(
    id, check_updates_daily, analytics_enabled, theme, onboarding_completed, api_base_url
) VALUES (1, ?, ?, ?, ?, ?);
