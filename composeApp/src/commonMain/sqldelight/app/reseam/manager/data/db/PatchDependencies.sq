CREATE TABLE patch_dependencies (
    patch_id TEXT NOT NULL,
    dep_name TEXT NOT NULL,
    PRIMARY KEY (patch_id, dep_name),
    FOREIGN KEY(patch_id) REFERENCES patches(id) ON DELETE CASCADE
);

selectByPatch:
SELECT dep_name FROM patch_dependencies WHERE patch_id = ?;

upsert:
INSERT OR REPLACE INTO patch_dependencies(patch_id, dep_name) VALUES (?, ?);

deleteByPatch:
DELETE FROM patch_dependencies WHERE patch_id = ?;
